# Microsoft 365 — one multi-tenant app registration (Azure Portal > App registrations >
# "Accounts in any organizational directory" > Redirect URI "Mobile and desktop applications"
# http://localhost > Allow public client flows: Yes). Delegated scopes:
# Mail.Read Calendars.Read Tasks.Read Chat.Read
M365_CLIENT_ID=

# One block per tenant, numbered from 1. Alias becomes the source id (m365_<alias>).
# Set M365_ORG<n>_CLIENT_ID only if that tenant required its own app registration.
M365_ORG1_ALIAS=work
M365_ORG1_TENANT_ID=
M365_ORG1_CLIENT_ID=

M365_ORG2_ALIAS=
M365_ORG2_TENANT_ID=
M365_ORG2_CLIENT_ID=

# Which alias's mailbox holds your Microsoft To Do lists
MSTODO_ORG_ALIAS=work

# Zoom — Marketplace > Develop > Build App > Server-to-Server OAuth. Create as the account owner.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Slack — one SLACK_<LABEL>_TOKEN per workspace; LABEL becomes the source id (slack_<label>).
# Non-distributed app, User OAuth Token (xoxp-...), token rotation off.
SLACK_WORK_TOKEN=

# Set to 1 if you dropped im:history / im:read — the health check stops requiring them.
SLACK_SKIP_DMS=

# Gmail — one shared OAuth Desktop client (your own Google Cloud project, consent screen published
# to "In production", gmail.readonly only) plus one refresh token per account. Mint each token with
# `python auth/gmail_bootstrap.py <label>` and paste the line it prints. GMAIL_<LABEL>_REFRESH_TOKEN
# is per account; LABEL becomes the source id (gmail_<label>). Never commit or share the client id.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_PERSONAL_REFRESH_TOKEN=

# Phase 3 synthesis — an Anthropic API key (create one in the Anthropic Console). The map/triage
# model id is optional and defaults to the current Haiku tier; ids are config because model
# retirements are announced with notice and the default will eventually need replacing.
ANTHROPIC_API_KEY=
SIGNALSLATE_MAP_MODEL=

# reMarkable — path to rmapi.conf written by pairing (Phase 5)
RMAPI_CONFIG=tokens/rmapi.conf

# Timezone the schedule cron is interpreted in, e.g. America/New_York. Unset means UTC in the
# container, which is almost certainly not when you want your morning digest.
TZ=

# LAN address of the Docker host — the browser calls the API at http://<LAN_HOST>:8000
LAN_HOST=

# Management UI (the Connections page). Encryption key for secrets stored at rest. Generate one with
# `python -m pipeline.crypto genkey` and back it up separately from data/: losing it loses every
# stored secret. Comma-separated for rotation, primary key first; the rest only decrypt. Leave blank
# and the app keeps running from this file exactly as before; the UI shows a banner and cannot store secrets.
SIGNALSLATE_SECRET_KEY=

# Browser origins allowed to make changes through the API, comma-separated, exactly as typed in the
# address bar (scheme, host, port). Blank means http://localhost:3000 plus http://<LAN_HOST>:3000.
# The first entry is also where the automatic sign-in callback sends your browser afterwards, so it
# must be the address you actually browse to.
WEB_ORIGINS=

# Extra hostnames the API answers to, comma-separated, hostnames only (no scheme, path or port;
# case-insensitive; wildcards are ignored). The API already accepts localhost, 127.0.0.1, ::1,
# LAN_HOST, the hosts of WEB_ORIGINS and the host of PUBLIC_BASE_URL and answers 400 host_not_allowed
# to any other Host header. Set this when you reach the API by another name or a reverse proxy
# forwards a different Host (for example the compose service name `api`). It defends against
# DNS-rebinding reads; it is not authentication. WEB_ORIGINS and ALLOWED_HOSTS are read at startup:
# restart after changing either.
ALLOWED_HOSTS=

# Public https address of this app, e.g. https://<your-host>, no path. Only needed for the automatic
# sign-in callback: the redirect URI registered with Google and Microsoft is
# <PUBLIC_BASE_URL>/api/oauth/callback/google or .../microsoft. Blank or non-https disables it;
# paste-back sign-in needs no public address.
PUBLIC_BASE_URL=

# Domains console (see "Domains" in the README). Registrar credentials are UI-only connections, not
# .env keys; these are only the purchasing guardrails and the refresh schedule.

# Master switch for buying a domain. Off leaves the portfolio, DNS/RDAP intel and availability
# checks working; only the buy flow is disabled. Keep false until you have run the full
# quote-then-purchase flow against a Namecheap sandbox or GoDaddy OTE connection.
DOMAINS_PURCHASE_ENABLED=false

# Highest price a single purchase may quote at, in the registrar account's currency. A quote above
# this is rejected even with purchasing enabled.
DOMAINS_MAX_PRICE=25

# Highest total spend allowed across all purchases in one day, same currency as DOMAINS_MAX_PRICE.
DOMAINS_DAILY_CAP=50

# Registrar-flagged premium-priced names are blocked from purchase unless this is true.
DOMAINS_ALLOW_PREMIUM=false

# Cron schedule (5-field) for the daily portfolio refresh job, interpreted in TZ above (UTC if
# unset). Default is 05:30.
DOMAINS_REFRESH_CRON="30 5 * * *"

# Optional LAN DNS resolver IP for domain lookups. Blank uses the system resolver.
DOMAINS_RESOLVER=
