# Microsoft 365 — one multi-tenant app registration (Azure Portal > App registrations >
# "Accounts in any organizational directory" > Redirect URI "Mobile and desktop applications"
# http://localhost > Allow public client flows: Yes). Delegated scopes:
# Mail.Read Calendars.Read Tasks.Read Chat.Read
M365_CLIENT_ID=

# One block per tenant, numbered from 1. Alias becomes the source id (m365_<alias>).
# Set M365_ORG<n>_CLIENT_ID only if that tenant required its own app registration.
M365_ORG1_ALIAS=work
M365_ORG1_TENANT_ID=
M365_ORG1_CLIENT_ID=

M365_ORG2_ALIAS=
M365_ORG2_TENANT_ID=
M365_ORG2_CLIENT_ID=

# Which alias's mailbox holds your Microsoft To Do lists
MSTODO_ORG_ALIAS=work

# Zoom — Marketplace > Develop > Build App > Server-to-Server OAuth. Create as the account owner.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Slack — one SLACK_<LABEL>_TOKEN per workspace; LABEL becomes the source id (slack_<label>).
# Non-distributed app, User OAuth Token (xoxp-...), token rotation off.
SLACK_WORK_TOKEN=

# Set to 1 if you dropped im:history / im:read — the health check stops requiring them.
SLACK_SKIP_DMS=

# reMarkable — path to rmapi.conf written by pairing (Phase 5)
RMAPI_CONFIG=tokens/rmapi.conf

# Timezone the schedule cron is interpreted in, e.g. America/New_York. Unset means UTC in the
# container, which is almost certainly not when you want your morning digest.
TZ=

# LAN address of the Docker host — the browser calls the API at http://<LAN_HOST>:8000
LAN_HOST=
